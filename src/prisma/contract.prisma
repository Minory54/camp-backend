// use prisma-8
enum Group_states {
  OPEN = "open"
  LOCKED = "locked"
  HIDDEN = "hidden"

  @@type("pg/text@1")
}

enum Question_types {
  SINGLE = "single"
  MULTIPLE = "multiple"

  @@type("pg/text@1")
}

// 1
model Code_languages {
  id             Int              @id @default(autoincrement())
  title          String           @unique

  Test_questions Test_questions[]
  Practice_files Practice_files[]
}

// 2
model Courses {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  description String?

  Groups      Groups[]
}

// 3 
model Students {
  id              Uuid                       @id @default(dbgenerated("gen_random_uuid()"))
  display_code    String                     @unique
  recovery_code   String                     @unique
  label           String?
  access_token    String                     @unique
  created_at      TimestamptzString          @default(now())
  updated_at      temporal.updatedAtString()

  //Student_sessions Student_sessions[]
  Lesson_progress Lesson_progress[]
  Practice_saves  Practice_saves[]
  Test_answers    Test_answers[]
}

